# Required server-only Neon PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Public Supabase Auth project configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Groq key used to generate personal 95-day learning paths.
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# Optional model overrides. These defaults separate strict generation from research.
GROQ_SYLLABUS_MODEL=openai/gpt-oss-120b
GROQ_RESEARCH_MODEL=groq/compound

# Optional isolated compiler service. The default uses the official Judge0 CE host.
JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_API_KEY=YOUR_SELF_HOSTED_JUDGE0_TOKEN
